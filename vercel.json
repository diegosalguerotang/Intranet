{
  "framework": "vite",
  "functions": { "api/portal-cuentas.js": { "maxDuration": 60 } },
  "redirects": [
    { "source": "/portal/", "destination": "/portal", "permanent": true }
  ],
  "rewrites": [
    { "source": "/portal", "destination": "https://intranet-portal-two.vercel.app/portal" },
    { "source": "/portal/:path*", "destination": "https://intranet-portal-two.vercel.app/portal/:path*" },
    { "source": "/api/supa/:ruta*", "destination": "/api/supa?ruta=:ruta*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
